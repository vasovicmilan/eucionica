                                <!-- ========================================================= -->
                                <!-- 1. UVOD U IoT                                              -->
                                <!-- ========================================================= -->
                                <section class="lection-section">
                                    <h2 class="lection-section__title">Šta je Internet of Things (IoT)?</h2>
                                    <div class="lection-section__content">
                                        <p><strong>Internet of Things (IoT)</strong> predstavlja mrežu fizičkih uređaja
                                            (senzora, aktuatora, pametnih aparata) koji su povezani na internet i
                                            međusobno komuniciraju. Ovi uređaji prikupljaju podatke iz okruženja,
                                            razmenjuju ih i na osnovu njih donose odluke – često bez ljudske
                                            intervencije.</p>
                                        <p>Primeri IoT uređaja: pametni termostati, pametne sijalice, sistemi za nadzor,
                                            nosivi uređaji (fitnes tracker-i), industrijski senzori, pa čak i gradski
                                            sistemi za parking ili osvetljenje.</p>
                                        <div class="note">
                                            💡 Procenjuje se da će do 2030. godine biti povezano preko 25 milijardi IoT
                                            uređaja širom sveta.
                                        </div>
                                    </div>
                                </section>

                                <!-- ========================================================= -->
                                <!-- 2. OTVORENO RAČUNARSTVO U IoT-U                              -->
                                <!-- ========================================================= -->
                                <section class="lection-section">
                                    <h2 class="lection-section__title">Otvoreno računarstvo kao pokretač IoT-a</h2>
                                    <div class="lection-section__content">
                                        <p>Otvoreno računarstvo (open source hardver i softver) igra ključnu ulogu u
                                            razvoju IoT-a. Za razliku od zatvorenih, proprietarnih sistema, otvoreni
                                            pristup donosi:</p>
                                        <ul>
                                            <li><strong>Transparentnost</strong> – svako može pregledati, analizirati i
                                                unaprediti kod firmvera ili hardverske šeme.</li>
                                            <li><strong>Interoperabilnost</strong> – otvoreni protokoli (MQTT, CoAP,
                                                HTTP) omogućavaju povezivanje uređaja različitih proizvođača.</li>
                                            <li><strong>Sigurnost</strong> – zajednica brže otkriva i popravlja
                                                ranjivosti (nema "sigurnosti kroz skrivanje").</li>
                                            <li><strong>Ekosistem</strong> – open source hardver (ESP32, Arduino,
                                                Raspberry Pi) i softver (FreeRTOS, Zephyr, Linux) ubrzavaju razvoj i
                                                smanjuju troškove.</li>
                                        </ul>
                                        <p><strong>ESP32</strong> je jedan od najpopularnijih open source
                                            mikrokontrolera – jeftin, moćan, sa ugrađenim Wi-Fi i Bluetooth-om, idealan
                                            za IoT projekte.</p>
                                    </div>
                                </section>

                                <!-- ========================================================= -->
                                <!-- 3. PROTOKOLI U IoT OKRUŽENJU                              -->
                                <!-- ========================================================= -->
                                <section class="lection-section">
                                    <h2 class="lection-section__title">Komunikacioni protokoli za IoT</h2>
                                    <div class="lection-section__content">
                                        <p>Za razliku od klasičnog web-a gde dominira HTTP/HTTPS, u IoT svetu se koriste
                                            specijalizovani protokoli prilagođeni ograničenim resursima (mala
                                            procesorska snaga, mala memorija, mala snaga baterije).</p>
                                        <div class="tech-grid">
                                            <div class="tech-item">
                                                <span class="tech-icon">🌐</span>
                                                <strong>HTTP/HTTPS</strong>
                                                <span class="tech-desc">Zahtev-odgovor, jednostavan, veliki overhead.
                                                    Pogodan za slanje podataka na server (REST API).</span>
                                            </div>
                                            <div class="tech-item">
                                                <span class="tech-icon">📡</span>
                                                <strong>MQTT</strong>
                                                <span class="tech-desc">Pub/Sub model, izuzetno lagan (minimalni header
                                                    2 bajta), idealan za senzorske mreže i embedded uređaje. Koristi
                                                    TCP.</span>
                                            </div>
                                            <div class="tech-item">
                                                <span class="tech-icon">🔄</span>
                                                <strong>CoAP</strong>
                                                <span class="tech-desc">UDP-based, dizajniran za RESTful arhitekturu sa
                                                    malim resursima. Sličan HTTP-u, ali efikasniji.</span>
                                            </div>
                                            <div class="tech-item">
                                                <span class="tech-icon">⚡</span>
                                                <strong>WebSocket</strong>
                                                <span class="tech-desc">Bidirekciona komunikacija u realnom vremenu,
                                                    mali latency. Često se koristi za dashboard-e i kontrolu
                                                    uređaja.</span>
                                            </div>
                                        </div>
                                        <p>U ovoj lekciji demonstriraćemo <strong>HTTP POST</strong> sa ESP32 na naš
                                            server, jer je to najjednostavniji način da se razume koncept slanja
                                            podataka sa uređaja.</p>
                                        <div class="note">
                                            📌 <strong>MQTT je često bolji izbor</strong> za IoT jer štedi energiju i
                                            bandwith, ali zahteva MQTT broker (npr. Mosquitto). HTTP je univerzalan i
                                            radi svuda.
                                        </div>
                                    </div>
                                </section>

                                <!-- ========================================================= -->
                                <!-- 4. PRINCIPI KOMUNIKACIJE U IoT-U                          -->
                                <!-- ========================================================= -->
                                <section class="lection-section">
                                    <h2 class="lection-section__title">Kako IoT uređaji komuniciraju? Osnovni principi
                                    </h2>
                                    <div class="lection-section__content">
                                        <p>Bez obzira koji protokol koristili (HTTP, MQTT, CoAP), svi IoT sistemi se
                                            oslanjaju na nekoliko osnovnih obrazaca komunikacije. Razumevanje ovih
                                            obrazaca ključno je za dizajniranje skalabilnih i efikasnih rešenja.</p>

                                        <h3>📡 1. Model klijent-server (zahtev-odgovor)</h3>
                                        <p>Ovo je najjednostavniji i najrasprostranjeniji obrazac. Klijent (npr. ESP32)
                                            šalje zahtev serveru i čeka odgovor. Server obrađuje zahtev i vraća odgovor
                                            (uspeh, greška, ili traženi podatak). <strong>HTTP</strong> i
                                            <strong>CoAP</strong> rade na ovom principu.</p>
                                        <ul>
                                            <li><strong>Prednost:</strong> Jednostavan za razumevanje i implementaciju.
                                            </li>
                                            <li><strong>Nedostatak:</strong> Server mora biti stalno dostupan; klijent
                                                mora da "pita" da bi dobio podatke (polling). Nije efikasan za veliki
                                                broj uređaja.</li>
                                        </ul>
                                        <p><em>Primer u našem projektu:</em> ESP32 šalje POST zahtev sa senzorskim
                                            podacima (temperatura, vlažnost, pritisak, vlaga zemlje, kiša, svetlost);
                                            server odgovara sa <code>{ status: "ok" }</code>.</p>

                                        <h3>📡 2. Model publish-subscribe (objavi-pretplati se)</h3>
                                        <p>Ovo je napredniji obrazac koji koriste MQTT, AMQP i neki drugi IoT protokoli.
                                            Umesto direktnog slanja serveru, uređaji komuniciraju preko posrednika –
                                            <strong>brokera</strong>. Uređaji <strong>objavljuju</strong> poruke na
                                            određene <strong>teme</strong>, a drugi uređaji koji su
                                            <strong>pretplaćeni</strong> na te teme primaju poruke. Objavljivač i
                                            pretplatnik ne znaju jedan za drugog – sistem je labavo povezan.</p>
                                        <ul>
                                            <li><strong>Prednost:</strong> Izuzetno skalabilan; odličan za distribuirane
                                                sisteme; uređaji mogu da primaju podatke u realnom vremenu bez
                                                konstantnog proveravanja.</li>
                                            <li><strong>Nedostatak:</strong> Zahteva dodatnu komponentu (broker),
                                                složeniji za postavljanje.</li>
                                        </ul>
                                        <p><em>Primer:</em> Pametna sijalica se pretplati na temu
                                            <code>komande/soba1/svetlo</code>. Kada mobilna aplikacija objavi
                                            <code>{"status": "ON"}</code> na toj temi, broker prosleđuje poruku sijalici
                                            koja pali svetlo.</p>

                                        <h3>📡 3. Poređenje HTTP i MQTT (najčešći izbori)</h3>
                                        <div class="tech-grid">
                                            <div class="tech-item">
                                                <strong>🌐 HTTP</strong>
                                                <ul style="margin-top: 0.5rem; margin-left: 1rem;">
                                                    <li>Tekstualni protokol (zaglavlja u ASCII)</li>
                                                    <li>Veliki overhead (često > 500 bajta po zahtevu)</li>
                                                    <li>Radi preko TCP (port 80/443)</li>
                                                    <li>Zahtev-odgovor, sinhrono</li>
                                                    <li>Lako prolazi kroz firewall-e</li>
                                                </ul>
                                            </div>
                                            <div class="tech-item">
                                                <strong>📡 MQTT</strong>
                                                <ul style="margin-top: 0.5rem; margin-left: 1rem;">
                                                    <li>Binarni protokol, minimalna zaglavlja (2 bajta!)</li>
                                                    <li>Izuzetno mali overhead – idealan za baterijske uređaje</li>
                                                    <li>Radi preko TCP (port 1883/8883 za TLS)</li>
                                                    <li>Pub/Sub, asinhrono</li>
                                                    <li>Kvalitet usluge (QoS) nivoi: 0,1,2</li>
                                                </ul>
                                            </div>
                                        </div>
                                        <p>U našem projektu koristimo HTTP jer je jednostavan za demonstraciju i ne
                                            zahteva dodatni broker. U realnim IoT sistemima, MQTT je često bolji izbor.
                                        </p>

                                        <h3>📡 4. Kako funkcioniše slanje JSON podataka preko HTTP?</h3>
                                        <p>Kada ESP32 šalje podatke, on formira HTTP poruku:</p>
                                        <pre class="code-block"><code>POST /otvoreno-racunarstvo/api/iot/sensor-data HTTP/1.1
Host: eucionica.onrender.com
Content-Type: application/json
Content-Length: 78

{"t":23.5,"h":60,"p":1013,"s":45,"r":10,"l":85}</code></pre>
                                        <p>Server (Express) parsira zaglavlja, prepoznaje JSON telo i prosleđuje ga
                                            kontroleru. Odgovor koji server vraća izgleda ovako:</p>
                                        <pre class="code-block"><code>HTTP/1.1 200 OK
Content-Type: application/json

{"status":"ok"}</code></pre>
                                        <p>Ovaj razgovor između klijenta i servera je <strong>stateless</strong> – svaki
                                            zahtev je nezavisan (REST princip).</p>

                                        <h3>📡 5. Zašto su otvoreni standardi ključni?</h3>
                                        <p>Otvoreni standardi (HTTP, MQTT, CoAP, JSON, TLS) omogućavaju da uređaji
                                            različitih proizvođača komuniciraju bez ikakvih barijera. Na primer, ESP32
                                            sa MQTT može da šalje podatke na cloud platformu koja koristi MQTT broker
                                            (npr. Mosquitto, EMQX), bez obzira da li je broker open source ili
                                            komercijalan. Takođe, otvoreni standardi garantuju da će podaci biti
                                            čitljivi i za 10 godina – nema "zaključavanja" u ekosistem jednog
                                            proizvođača.</p>
                                        <div class="note">
                                            💡 <strong>Ključna razlika:</strong> HTTP je <strong>sinhroni,
                                                zahtev-odgovor</strong> – klijent mora inicirati komunikaciju. MQTT je
                                            <strong>asinhroni, pub/sub</strong> – broker prosleđuje poruke čim stignu.
                                            Za senzore koji šalju podatke svakih nekoliko minuta, HTTP je sasvim
                                            dovoljan. Za sisteme koji zahtevaju trenutnu reakciju (npr. pametne brave,
                                            alarmi), MQTT je neophodan.
                                        </div>
                                    </div>
                                </section>

                                <!-- ========================================================= -->
                                <!-- 5. NAŠ PROJEKAT: Višenamenska meteorološka stanica         -->
                                <!-- ========================================================= -->
                                <section class="lection-section">
                                    <h2 class="lection-section__title">Primer: Višenamenska IoT stanica sa ESP32</h2>
                                    <div class="lection-section__content">
                                        <p>Napravićemo uređaj koji meri više parametara okruženja, prikazuje podatke na
                                            OLED displeju (sa mogućnošću prebacivanja ekrana preko tastera) i šalje
                                            očitanja na naš server.</p>
                                        <p><strong>Komponente:</strong></p>
                                        <ul>
                                            <li>ESP32 razvojna ploča</li>
                                            <li>DHT11 senzor temperature i vlažnosti vazduha (pin 5)</li>
                                            <li>BMP280 senzor temperature i atmosferskog pritiska (I2C)</li>
                                            <li>Senzor vlažnosti zemlje (analogni, pin 34)</li>
                                            <li>Senzor kiše (analogni, pin 35)</li>
                                            <li>Senzor svetlosti (fotootpornik, analogni, pin 32)</li>
                                            <li>OLED displej SSD1306 (I2C, SDA=21, SCL=22)</li>
                                            <li>Taster za promenu ekrana (pin 18, INPUT_PULLUP)</li>
                                        </ul>
                                        <p><strong>Funkcionalnost:</strong></p>
                                        <ul>
                                            <li><strong>Lokalno:</strong> OLED prikazuje 6 različitih ekrana koji se
                                                menjaju pritiskom na taster: pregled svih parametara, DHT11 podaci,
                                                BMP280 podaci, vlažnost zemlje, kiša, svetlost.</li>
                                            <li><strong>Na server:</strong> ESP32 svakih 10 sekundi šalje JSON sa svih 6
                                                vrednosti na naš API endpoint.</li>
                                        </ul>
                                    </div>
                                </section>

                                <!-- ========================================================= -->
                                <!-- 6. ESP32 KOD (sakriven u details)                          -->
                                <!-- ========================================================= -->
                                <section class="lection-section">
                                    <h2 class="lection-section__title">📟 Arduino kod za ESP32</h2>
                                    <div class="lection-section__content">
                                        <p>Kod je organizovan u funkcije, koristi <code>millis()</code> za slanje podataka
                                            i debounce za taster. Podaci se šalju na server nezavisno od osvežavanja displeja.</p>
                                        <details class="code-details">
                                            <summary>🔽 Prikaži kompletan Arduino kod</summary>
                                            <pre class="code-block"><code>#include &lt;WiFi.h&gt;
#include &lt;HTTPClient.h&gt;
#include &lt;Wire.h&gt;
#include &lt;Adafruit_GFX.h&gt;
#include &lt;Adafruit_SSD1306.h&gt;
#include &lt;Adafruit_BMP280.h&gt;
#include &lt;DHT.h&gt;

// WIFI - ZAMENI SA SVOJIM PODACIMA
const char* ssid = "TVOJA_SSID";
const char* password = "TVOJA_LOZINKA";
const char* serverUrl = "https://eucionica.onrender.com/otvoreno-racunarstvo/api/iot/sensor-data";

// OLED
#define SCREEN_WIDTH 128
#define SCREEN_HEIGHT 64
Adafruit_SSD1306 display(SCREEN_WIDTH, SCREEN_HEIGHT, &Wire, -1);

// DHT
#define DHTPIN 5
#define DHTTYPE DHT11
DHT dht(DHTPIN, DHTTYPE);

// BMP280
Adafruit_BMP280 bmp;

// Pinovi
#define BUTTON_PIN 18
#define SOIL_PIN 34
#define RAIN_PIN 35
#define LIGHT_PIN 32

// Kontrola ekrana
int screen = 0;

// Debounce tastera
bool buttonState = HIGH;
bool lastReading = HIGH;
unsigned long lastDebounceTime = 0;
unsigned long debounceDelay = 200;

// Slanje podataka na server
unsigned long lastSend = 0;
unsigned long sendInterval = 10000; // 10 sekundi

void setup() {
  Serial.begin(115200);

  pinMode(BUTTON_PIN, INPUT_PULLUP);

  // I2C (SDA=21, SCL=22)
  Wire.begin(21, 22);

  // OLED inicijalizacija
  if(!display.begin(SSD1306_SWITCHCAPVCC, 0x3C)) {
    Serial.println("OLED nije pronadjen!");
    while(1);
  }

  // DHT
  dht.begin();

  // BMP280 (adresa 0x76 ili 0x77)
  if (!bmp.begin(0x76)) {
    if (!bmp.begin(0x77)) {
      Serial.println("BMP280 nije pronadjen!");
      while (1);
    }
  }

  // Povezivanje na WiFi
  WiFi.begin(ssid, password);
  Serial.print("Povezivanje na WiFi");
  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
    Serial.print(".");
  }
  Serial.println("\nWiFi povezan!");

  display.clearDisplay();
}

// Funkcija za taster (promena ekrana)
void handleButton() {
  bool reading = digitalRead(BUTTON_PIN);

  if (reading != lastReading) {
    lastDebounceTime = millis();
  }

  if ((millis() - lastDebounceTime) > debounceDelay) {
    if (reading != buttonState) {
      buttonState = reading;
      if (buttonState == LOW) {
        screen++;
        if (screen > 5) screen = 0;
        Serial.println("Promena ekrana!");
      }
    }
  }
  lastReading = reading;
}

// Slanje podataka na server
void sendData(float t, float h, float p, int soil, int rain, int light) {
  if (WiFi.status() != WL_CONNECTED) return;

  HTTPClient http;
  http.begin(serverUrl);
  http.addHeader("Content-Type", "application/json");

  char payload[128];
  snprintf(payload, sizeof(payload),
    "{\"t\":%.1f,\"h\":%.0f,\"p\":%.0f,\"s\":%d,\"r\":%d,\"l\":%d}",
    t, h, p, soil, rain, light
  );

  int code = http.POST(payload);
  Serial.print("HTTP odgovor: ");
  Serial.println(code);
  http.end();
}

void loop() {
  handleButton();

  // Čitanje senzora
  float tempDHT = dht.readTemperature();
  float hum = dht.readHumidity();
  float tempBMP = bmp.readTemperature();
  float pressure = bmp.readPressure() / 100.0F;

  int soilRaw = analogRead(SOIL_PIN);
  int rainRaw = analogRead(RAIN_PIN);
  int lightRaw = analogRead(LIGHT_PIN);

  // Konverzija u procente (kalibracija zavisi od senzora)
  int soilPercent = map(soilRaw, 4000, 1000, 0, 100);
  int rainPercent = map(rainRaw, 4000, 1000, 0, 100);
  rainPercent = constrain(rainPercent, 0, 100);
  int lightPercent = map(lightRaw, 4000, 0, 0, 100);

  // Slanje na server svakih 10 sekundi
  if (millis() - lastSend > sendInterval) {
    lastSend = millis();
    sendData(tempDHT, hum, pressure, soilPercent, rainPercent, lightPercent);
  }

  // Prikaz na OLED-u u zavisnosti od izabranog ekrana
  display.clearDisplay();
  display.setTextSize(1);
  display.setTextColor(WHITE);

  switch(screen) {
    case 0:
      // Pregled svih parametara
      display.setCursor(0,0);
      display.println("Overview");
      display.print("T:"); display.print(tempDHT); display.print("C ");
      display.print("H:"); display.print(hum); display.println("%");
      display.print("P:"); display.print(pressure); display.println("hPa");
      display.print("Soil:"); display.print(soilPercent); display.println("%");
      display.print("Rain:"); display.print(rainPercent); display.println("%");
      display.print("Light:"); display.print(lightPercent); display.println("%");
      break;
    case 1:
      display.setCursor(0,0);
      display.println("DHT11");
      display.print("Temp: "); display.print(tempDHT); display.println(" C");
      display.print("Humidity: "); display.print(hum); display.println(" %");
      break;
    case 2:
      display.setCursor(0,0);
      display.println("BMP280");
      display.print("Temp: "); display.print(tempBMP); display.println(" C");
      display.print("Pressure: "); display.print(pressure); display.println(" hPa");
      break;
    case 3:
      display.setCursor(0,0);
      display.println("Soil Moisture");
      display.print("Value: "); display.print(soilPercent); display.println("%");
      if (soilPercent < 30) display.println("DRY!");
      else display.println("OK");
      break;
    case 4:
      display.setCursor(0,0);
      display.println("Rain Sensor");
      display.print("Value: "); display.print(rainPercent); display.println("%");
      if (rainPercent > 70) display.println("RAIN!");
      else display.println("Dry");
      break;
    case 5:
      display.setCursor(0,0);
      display.println("Light Sensor");
      display.print("Value: "); display.print(lightPercent); display.println("%");
      if (lightPercent < 20) display.println("Dark");
      else display.println("Bright");
      break;
  }
  display.display();
  delay(300);
}</code></pre>
                                        </details>
                                        <div class="note">
                                            ⚠️ <strong>Pre nego što učitaš kod:</strong>
                                            <ul>
                                                <li>Zameni <code>ssid</code> i <code>password</code> sa svojim Wi-Fi podacima.</li>
                                                <li>Zameni <code>serverUrl</code> sa stvarnom adresom (npr. <code>https://eucionica.onrender.com/otvoreno-racunarstvo/api/iot/sensor-data</code>).</li>
                                                <li>Instaliraj biblioteke: <strong>DHT sensor library</strong>, <strong>Adafruit BMP280 Library</strong>, <strong>Adafruit GFX Library</strong>, <strong>Adafruit SSD1306</strong> (Library Manager).</li>
                                                <li>Proveri I2C adresu BMP280 (0x76 ili 0x77) i pinove za I2C (SDA=21, SCL=22).</li>
                                            </ul>
                                        </div>
                                    </div>
                                </section>

                                <!-- ========================================================= -->
                                <!-- 7. BACKEND – PRIJEM PODATAKA                              -->
                                <!-- ========================================================= -->
                                <section class="lection-section">
                                    <h2 class="lection-section__title">Server (Express) – rute i kontroler</h2>
                                    <div class="lection-section__content">
                                        <p>Na Express serveru dodajemo dva endpoint-a:</p>
                                        <ul>
                                            <li><code>POST /otvoreno-racunarstvo/api/iot/sensor-data</code> – prima JSON podatke sa ključevima <code>t, h, p, s, r, l</code> i čuva ih u memoriji.</li>
                                            <li><code>GET /otvoreno-racunarstvo/api/iot/latest-readings</code> – vraća poslednjih 20 očitanja (za prikaz na dashboardu).</li>
                                        </ul>
                                        <details class="code-details">
                                            <summary>🔽 Prikaži kontroler (<code>iot.controller.js</code>)</summary>
                                            <pre class="code-block"><code>let sensorReadings = [];

export function receiveSensorData(req, res) {
  const { t, h, p, s, r, l } = req.body;

  if (t === undefined || h === undefined || p === undefined || s === undefined || r === undefined || l === undefined) {
    return res.status(400).json({ error: "Nedostaju podaci (t, h, p, s, r, l)" });
  }

  const reading = {
    device: req.body.device || "esp32",
    temperature: parseFloat(t),
    humidity: parseFloat(h),
    pressure: parseFloat(p),
    soil: parseInt(s),
    rain: parseInt(r),
    light: parseInt(l),
    timestamp: new Date().toISOString()
  };

  sensorReadings.unshift(reading);
  if (sensorReadings.length > 50) sensorReadings.pop();

  console.log(`[IoT] ${reading.device} | T:${reading.temperature}°C H:${reading.humidity}% P:${reading.pressure}hPa S:${reading.soil}% R:${reading.rain}% L:${reading.light}%`);

  res.status(200).json({ status: "ok" });
}

export function getLatestReadings(req, res) {
  res.json(sensorReadings.slice(0, 20));
}</code></pre>
                                        </details>
                                        <p>Rute dodati u <code>routes/web/otvoreno-racunarstvo/index.js</code>:</p>
                                        <pre class="code-block"><code>import { receiveSensorData, getLatestReadings } from "../../../controllers/web/otvoreno-racunarstvo/iot.controller.js";

router.post("/api/iot/sensor-data", receiveSensorData);
router.get("/api/iot/latest-readings", getLatestReadings);</code></pre>
                                        <p>Ne zaboravi <code>express.json()</code> middleware u <code>app.js</code>.</p>
                                    </div>
