<!DOCTYPE html>
<html lang="sr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <!-- Title -->
    <title><%= typeof title !== 'undefined' ? title + ' | ' : '' %>EUCIONICA</title>

    <!-- Description & Keywords -->
    <% if (typeof pageDescription !== 'undefined' && pageDescription) { %>
        <meta name="description" content="<%= pageDescription %>">
    <% } %>
    <% if (typeof pageKeywords !== 'undefined' && pageKeywords) { %>
        <meta name="keywords" content="<%= pageKeywords %>">
    <% } %>

    <!-- Favicons -->
    <link rel="icon" href="/public/images/favicon.ico">
    <link rel="apple-touch-icon" sizes="180x180" href="/public/images/apple-touch-icon.png">

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <!-- Base CSS -->
    <link rel="stylesheet" href="/public/css/styles.css">

    <!-- Page-specific CSS (može biti string ili niz) -->
    <% if (typeof pageStyles !== 'undefined' && pageStyles) { %>
        <% if (typeof pageStyles === 'string') { %>
            <link rel="stylesheet" href="/public/css/<%= pageStyles %>">
        <% } else if (Array.isArray(pageStyles)) { %>
            <% pageStyles.forEach(function(style) { %>
                <link rel="stylesheet" href="/public/css/<%= style %>">
            <% }); %>
        <% } %>
    <% } %>
</head>
<body>